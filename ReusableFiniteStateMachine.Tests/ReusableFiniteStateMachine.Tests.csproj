<Project Sdk="Microsoft.NET.Sdk">
  
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!--<LangVersion>latest</LangVersion>-->
    <LangVersion>preview</LangVersion>
    <!--<DefineConstants>$(DefineConstants);UNDER_TEST</DefineConstants>-->
  </PropertyGroup>

  <PropertyGroup>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>Generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="$(CompilerGeneratedFilesOutputPath)/**/*.cs" />
    <Compile Remove="DEPRECATED\**" />
    <EmbeddedResource Remove="DEPRECATED\**" />
    <None Remove="DEPRECATED\**" />
  </ItemGroup>
  
  
  <ItemGroup>
    <PackageReference Include="TUnit" Version="1.65.68" />
    <PackageReference Include="TUnit.Mocks" Version="1.65.68" />
    <PackageReference Include="TUnit.Mocks.Assertions" Version="1.65.68" />
  </ItemGroup>

  <ItemGroup>    
    <ProjectReference Include="..\ReusableFiniteStateMachine\ReusableFiniteStateMachine.csproj" />
  </ItemGroup>

</Project>
